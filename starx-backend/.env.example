# StarX backend application name
STARX_APP_NAME=StarX Backend

# API prefix exposed by FastAPI
STARX_API_PREFIX=/api/v1

# Backend listening port
STARX_PORT=10102

# PostgreSQL connection string
# This value can be async for app runtime; Alembic will convert asyncpg to psycopg automatically.
STARX_DATABASE_URL=
STARX_DB_POOL_SIZE=10
STARX_DB_MAX_OVERFLOW=20
STARX_DB_POOL_TIMEOUT=30
STARX_DB_POOL_RECYCLE=1800
STARX_DB_POOL_PRE_PING=true

# Redis connection string
STARX_REDIS_URL=

# Object storage config
# Fill the storage settings required by the target environment; secrets stay empty in this template.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_UPLOAD_DIR=
OSS_USE_CNAME=false
STARX_DIRECT_UPLOAD_URL_EXPIRE_SECONDS=300

# AI provider config
STARX_DEFAULT_BASE_URL=
STARX_DEFAULT_TOKEN=
STARX_DEFAULT_VOICE_DISCERN_MODEL=qwen3-asr-flash
STARX_DEFAULT_VOICE_FILETRANS_MODEL=qwen3-asr-flash-filetrans
STARX_VIDEO_ANALYSIS_USE_FILETRANS=false
STARX_VIDEO_ANALYSIS_FLASH_TARGET_SEGMENT_SECONDS=90
STARX_VIDEO_ANALYSIS_FLASH_SEGMENT_SEARCH_SECONDS=30
STARX_DEFAULT_TIMEOUT=360
# Image generation/editing can take several minutes at the upstream provider.
STARX_DEFAULT_IMAGE_GENERATION_TIMEOUT=360

# Autophone publish service config
# AUTOPHONE_* aliases are also accepted.
STARX_AUTOPHONE_BASE_URL=
STARX_AUTOPHONE_CLIENT_ID=
STARX_AUTOPHONE_CLIENT_SECRET=
STARX_AUTOPHONE_TIMEOUT=30

# Doubao online search config. Keep the real API key only in .env or a secret manager.
STARX_DOUBAO_SEARCH_API_URL=https://open.feedcoopapi.com/search_api/web_search
STARX_DOUBAO_SEARCH_API_KEY=
STARX_DOUBAO_SEARCH_TIMEOUT=30

# TikHub official Python SDK config. Keep the real API key only in .env or a secret manager.
# Mainland China deployments should use https://api.tikhub.dev; other regions use .io.
STARX_SOCIAL_RETRIEVAL_PROVIDER=hybrid
STARX_TIKHUB_BASE_URL=https://api.tikhub.dev
STARX_TIKHUB_API_KEY=
STARX_TIKHUB_TIMEOUT=45
STARX_TIKHUB_MAX_RETRIES=3
STARX_TIKHUB_QPS=8
STARX_TIKHUB_MAX_IN_FLIGHT=16

STARX_WORKFLOW_MAX_CONCURRENT=3
STARX_COMPETITOR_REFRESH_HOUR=4
STARX_COMPETITOR_REFRESH_TIMEZONE=Asia/Shanghai
STARX_COMPETITOR_SCHEDULER_SCAN_SECONDS=60
STARX_COMPETITOR_SCHEDULER_BATCH_SIZE=20
STARX_COMPETITOR_WORKFLOW_STALE_SECONDS=7200
STARX_COMPETITOR_WORKFLOW_HEARTBEAT_SECONDS=60
STARX_COMPETITOR_CRAWL_MAX_ATTEMPTS=3
STARX_COMPETITOR_CRAWL_RETRY_BACKOFF_SECONDS=1.0
STARX_COMPETITOR_ACCOUNT_MAX_NOTES_COUNT=20
STARX_COMPETITOR_ACCOUNT_DETAIL_LIMIT=5
STARX_COMPETITOR_ACCOUNT_DETAIL_CONCURRENCY=2
# 自有账号作品看板：每小时采集一次点赞、评论、收藏和分享累计值。
STARX_OWN_DASHBOARD_REFRESH_SECONDS=3600
STARX_OWN_DASHBOARD_SCHEDULER_SCAN_SECONDS=60
STARX_OWN_DASHBOARD_SCHEDULER_BATCH_SIZE=10
STARX_OWN_DASHBOARD_RECENT_CONTENT_LIMIT=50
STARX_IMAGE_GENERATION_SUB_JOB_CONCURRENCY=5
STARX_MAX_UPLOAD_IMAGE_BYTES=10485760
STARX_MAX_EXTRACT_MEDIA_BYTES=83886080
STARX_VIDEO_ANALYSIS_MAX_SOURCE_BYTES=1073741824
STARX_VIDEO_ANALYSIS_DIRECT_MAX_BYTES=83886080
STARX_VIDEO_ANALYSIS_DIRECT_MAX_SECONDS=180
STARX_VIDEO_ANALYSIS_SEGMENT_SECONDS=90
STARX_VIDEO_ANALYSIS_SEGMENT_OVERLAP_SECONDS=2
STARX_VIDEO_ANALYSIS_SEGMENT_CONCURRENCY=2
STARX_VIDEO_ANALYSIS_SEGMENT_MAX_ATTEMPTS=2
STARX_VIDEO_ANALYSIS_SEGMENT_RETRY_BACKOFF_SECONDS=1
STARX_VIDEO_ANALYSIS_AI_TIMEOUT_SECONDS=180
STARX_MAX_EXTRACT_MEDIA_ITEMS=12
STARX_MAX_GENERATED_IMAGE_BYTES=26214400

# Digital human / voice clone. Keep all real credentials only in .env or a secret manager.
STARX_DIGITAL_HUMAN_BAILIAN_API_KEY=
STARX_DIGITAL_HUMAN_KYY_API_KEY=
STARX_DIGITAL_HUMAN_KYY_BASE_URL=https://zcbservice.aizfw.cn/kyyReactApiServer
STARX_DIGITAL_HUMAN_POLL_INTERVAL_SECONDS=30
STARX_DIGITAL_HUMAN_POLL_MAX_ATTEMPTS=120
STARX_DIGITAL_HUMAN_MAX_CONSECUTIVE_ERRORS=20
STARX_DIGITAL_HUMAN_SOURCE_MIN_SECONDS=10
STARX_DIGITAL_HUMAN_FFMPEG_PATH=
STARX_DIGITAL_HUMAN_FFPROBE_PATH=
STARX_DIGITAL_HUMAN_DASHSCOPE_TIMEOUT_SECONDS=180
STARX_DIGITAL_HUMAN_DASHSCOPE_MAX_ATTEMPTS=3
STARX_DIGITAL_HUMAN_DASHSCOPE_RETRY_BASE_DELAY_SECONDS=1
# Alibaba Cloud ICE editing. Output bucket must be an OSS bucket in the ICE region.
STARX_DIGITAL_HUMAN_ICE_ACCESS_KEY_ID=
STARX_DIGITAL_HUMAN_ICE_ACCESS_KEY_SECRET=
STARX_DIGITAL_HUMAN_ICE_REGION=cn-beijing
STARX_DIGITAL_HUMAN_ICE_ENDPOINT=ice.cn-beijing.aliyuncs.com
STARX_DIGITAL_HUMAN_ICE_OUTPUT_BUCKET=
STARX_DIGITAL_HUMAN_ICE_OUTPUT_PREFIX=digital-human/ice-results
STARX_DIGITAL_HUMAN_ICE_FONT_URL=
# 可选：MPS 转码模板 ID。建议配置 AAC-LC、48kHz、双声道、192~256kbps，
# 并开启最终响度/真峰值控制；ICE 会通过 ProduceTemplateId 应用该模板。
STARX_DIGITAL_HUMAN_ICE_PRODUCE_TEMPLATE_ID=

# Browser and CDP options
STARX_MEDIASPIDER_HEADLESS=true
STARX_MEDIASPIDER_ENABLE_CDP_MODE=false
STARX_MEDIASPIDER_CDP_CONNECT_EXISTING=false
STARX_MEDIASPIDER_CDP_DEBUG_PORT=9222
STARX_MEDIASPIDER_CUSTOM_BROWSER_PATH=

# Proxy：HTTP 爬虫启用后，每次 run_crawler 消耗 1 个快代理 IP。
STARX_MEDIASPIDER_ENABLE_IP_PROXY=false
STARX_MEDIASPIDER_IP_PROXY_PROVIDER=kuaidaili
STARX_MEDIASPIDER_STATIC_PROXY_URL=
# 快代理 DPS —— 由 Settings 统一读取（代码不走 os.getenv）
# 推荐 STARX_KDL_*；兼容历史 KDL_* / 小写 kdl_*
# SecretId / SecretKey(作 signature) —— getdps 提取 IP、getipbalance 查余量
# 官方：提取 ip:port 后用 用户名:密码 拼 http://user:pwd@ip:port/
STARX_KDL_SECERT_ID=
STARX_KDL_SIGNATURE=
STARX_KDL_USER_NAME=
STARX_KDL_USER_PWD=
# 可选：地区筛选，如 苏州；完整提取链接里已带 area 时以链接为准
STARX_KDL_AREA=
STARX_KDL_GETDPS_URL=
# 同一 IP 复用秒数；窗口内多次爬虫请求不重复扣额度（默认 180=3 分钟）
STARX_KDL_PROXY_REUSE_SECONDS=180

# Feishu cookie health notify (custom bot webhook)
# 飞书群 → 设置 → 群机器人 → 自定义机器人 → 复制 Webhook
FEISHU_COOKIE_WEBHOOK=
# 若机器人开启了「签名校验」，填写密钥
FEISHU_COOKIE_SECRET=

# 快代理 IP 余量推送（建议每 3 小时）
FEISHU_KDL_WEBHOOK=
FEISHU_KDL_SECRET=

# Crawl limits
STARX_MEDIASPIDER_MAX_NOTES_COUNT=30
STARX_MEDIASPIDER_MAX_COMMENTS_COUNT=20
STARX_MEDIASPIDER_MAX_CONCURRENCY=3
STARX_ACCOUNT_REPORT_MAX_NOTES_PER_KEYWORD=10
STARX_MEDIASPIDER_ENABLE_COMMENTS=false
STARX_MEDIASPIDER_ENABLE_SUB_COMMENTS=false
