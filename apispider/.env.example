# StarX backend application name
STARX_APP_NAME=StarX Backend

# API prefix exposed by FastAPI
STARX_API_PREFIX=/api/v1

# PostgreSQL connection string
# This value can be async for app runtime; Alembic will convert asyncpg to psycopg automatically.
STARX_DATABASE_URL=
STARX_DB_POOL_SIZE=10
STARX_DB_MAX_OVERFLOW=20
STARX_DB_POOL_TIMEOUT=30
STARX_DB_POOL_RECYCLE=1800
STARX_DB_POOL_PRE_PING=true

# Redis connection string
STARX_REDIS_URL=

# Object storage config
# Fill the storage settings required by the target environment; secrets stay empty in this template.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_UPLOAD_DIR=
OSS_USE_CNAME=false

# AI provider config
STARX_DEFAULT_BASE_URL=
STARX_DEFAULT_TOKEN=
STARX_DEFAULT_TIMEOUT=360
# Image generation/editing can take several minutes at the upstream provider.
STARX_DEFAULT_IMAGE_GENERATION_TIMEOUT=360

# Autophone publish service config
# AUTOPHONE_* aliases are also accepted.
STARX_AUTOPHONE_BASE_URL=
STARX_AUTOPHONE_CLIENT_ID=
STARX_AUTOPHONE_CLIENT_SECRET=
STARX_AUTOPHONE_TIMEOUT=30

# Doubao online search config. Keep the real API key only in .env or a secret manager.
STARX_DOUBAO_SEARCH_API_URL=https://open.feedcoopapi.com/search_api/web_search
STARX_DOUBAO_SEARCH_API_KEY=
STARX_DOUBAO_SEARCH_TIMEOUT=30

# TikHub official Python SDK config. Keep the real API key only in .env or a secret manager.
# Mainland China deployments should use https://api.tikhub.dev; other regions use .io.
STARX_SOCIAL_RETRIEVAL_PROVIDER=tikhub
STARX_TIKHUB_BASE_URL=https://api.tikhub.dev
STARX_TIKHUB_API_KEY=
STARX_TIKHUB_TIMEOUT=45
STARX_TIKHUB_MAX_RETRIES=3
STARX_TIKHUB_QPS=8
STARX_TIKHUB_MAX_IN_FLIGHT=16

STARX_WORKFLOW_MAX_CONCURRENT=3
STARX_COMPETITOR_REFRESH_INTERVAL_SECONDS=21600
STARX_COMPETITOR_SCHEDULER_SCAN_SECONDS=60
STARX_COMPETITOR_SCHEDULER_BATCH_SIZE=20
STARX_COMPETITOR_WORKFLOW_STALE_SECONDS=7200
STARX_COMPETITOR_WORKFLOW_HEARTBEAT_SECONDS=60
STARX_COMPETITOR_CRAWL_MAX_ATTEMPTS=3
STARX_COMPETITOR_CRAWL_RETRY_BACKOFF_SECONDS=1.0
STARX_IMAGE_GENERATION_SUB_JOB_CONCURRENCY=5
STARX_MAX_UPLOAD_IMAGE_BYTES=10485760
STARX_MAX_EXTRACT_MEDIA_BYTES=83886080
STARX_MAX_EXTRACT_MEDIA_ITEMS=12
STARX_MAX_GENERATED_IMAGE_BYTES=26214400

# Browser and CDP options
STARX_MEDIASPIDER_HEADLESS=true
STARX_MEDIASPIDER_ENABLE_CDP_MODE=false
STARX_MEDIASPIDER_CDP_CONNECT_EXISTING=false
STARX_MEDIASPIDER_CDP_DEBUG_PORT=9222
STARX_MEDIASPIDER_CUSTOM_BROWSER_PATH=

# Proxy options. Treat authenticated proxy URLs as secrets.
STARX_MEDIASPIDER_ENABLE_IP_PROXY=false
STARX_MEDIASPIDER_IP_PROXY_PROVIDER=kuaidaili
STARX_MEDIASPIDER_STATIC_PROXY_URL=

# Crawl limits
STARX_MEDIASPIDER_MAX_NOTES_COUNT=30
STARX_MEDIASPIDER_MAX_COMMENTS_COUNT=20
STARX_MEDIASPIDER_MAX_CONCURRENCY=3
STARX_ACCOUNT_REPORT_MAX_NOTES_PER_KEYWORD=10
STARX_MEDIASPIDER_ENABLE_COMMENTS=true
STARX_MEDIASPIDER_ENABLE_SUB_COMMENTS=false
