# Platform is selected by the command. Activation codes select isolated local
# workspaces under adapter_data/workspaces/. Do not put platform Cookie values
# in environment variables because global credentials cannot be workspace-scoped.

# RabbitMQ credentials. Never commit real credentials to this file.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=adapter
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# IM messaging contract.
MQ_EDGE2IM_MESSAGE_QUEUE=edge2im_messages
IM2EDGE_RECEIVE_EXCHANGE=im2edge.events
IM2EDGE_RECEIVE_EXCHANGE_TYPE=topic
IM2EDGE_RECEIVE_ROUTING_KEY=im2edge_messages
IM2EDGE_RECEIVE_QUEUE=im2edge_messages
# 发送结果：0 成功，1 失败。
SEND_STATUS_SUCCESS=0
SEND_STATUS_FAILED=1

# Account monitor alerts on the test server. Online accounts resend
# alert_type=online every 40 seconds, inside the monitor's 120-second timer.
# An expired account, a drop, or a clean exit sends alert_type=offline.
# Do not commit the secret.
ACCOUNT_ALERT_URL=http://115.29.200.91:10003/api/v1/lightreply/account_monitor/internal/alert
ACCOUNT_ALERT_INTERNAL_SECRET=

# Public control gateway used for IM gRPC account operations. HTTPS is the
# default. Remote HTTP requires the explicit opt-in below.
ADAPTER_GATEWAY_URL=
ADAPTER_GATEWAY_TIMEOUT_SECONDS=15
ADAPTER_GATEWAY_ALLOW_INSECURE_HTTP=false

# Reliability controls.
ADAPTER_PREFETCH_COUNT=1
ADAPTER_MESSAGE_TTL_MS=604800000
ADAPTER_SINGLE_ACTIVE_CONSUMER=true

# Outbound platform risk controls. Each text attempt is spaced by 4-8 seconds,
# with rolling hard caps. BOSS_SEND_* / DOUYIN_SEND_* / REDNOTE_SEND_* may override these values.
ADAPTER_SEND_MIN_INTERVAL_SECONDS=4
ADAPTER_SEND_JITTER_SECONDS=4
ADAPTER_SEND_MAX_PER_MINUTE=8
ADAPTER_SEND_MAX_PER_HOUR=120

# Decrypted Douyin images are uploaded here so the downstream IM can fetch them.
# OSS_UPLOAD_DIR is the object-key prefix, for example edge/image/YYYY/MM/DD/.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_UPLOAD_DIR=edge
OSS_PUBLIC_BASE_URL=
