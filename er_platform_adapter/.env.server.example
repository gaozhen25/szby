# Public HTTP server. Bind to loopback when TLS is terminated by nginx/Caddy.
ADAPTER_GATEWAY_HOST=127.0.0.1
ADAPTER_GATEWAY_PORT=8080
ADAPTER_GATEWAY_DB=adapter_gateway_data/gateway.sqlite3

# Internal IM gRPC target. Keep plaintext traffic inside the private network.
IM_GRPC_TARGET=127.0.0.1:30500
IM_GRPC_TLS=false
IM_GRPC_TIMEOUT_SECONDS=10

# Activation abuse protection per source IP and rolling window.
ADAPTER_GATEWAY_ACTIVATION_LIMIT=10
ADAPTER_GATEWAY_ACTIVATION_WINDOW_SECONDS=600
