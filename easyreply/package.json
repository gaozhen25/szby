{
  "name": "qinghui",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(!ua.includes('pnpm')){console.error('\\n请使用 pnpm 安装依赖：pnpm install\\n');process.exit(1)}\"",
    "start": "expo start",
    "start:test": "EXPO_PUBLIC_APP_ENV=test expo start",
    "start:test:dev": "EXPO_PUBLIC_APP_ENV=test expo start --dev-client -c",
    "start:prod": "EXPO_PUBLIC_APP_ENV=production expo start",
    "start:web": "expo start --web",
    "start:web:test": "EXPO_PUBLIC_APP_ENV=test expo start --web -c",
    "start:web:prod": "EXPO_PUBLIC_APP_ENV=production expo start --web -c",
    "android": "node scripts/sync-android-push-credentials.js && node scripts/adb-reverse-metro.js && REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo run:android --port 8099",
    "android:test": "node scripts/sync-android-push-credentials.js && node scripts/adb-reverse-metro.js && EXPO_PUBLIC_APP_ENV=test REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo run:android --port 8099",
    "android:prod": "node scripts/sync-android-push-credentials.js && node scripts/adb-reverse-metro.js && EXPO_PUBLIC_APP_ENV=production REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo run:android --port 8099",
    "android:release:test": "node scripts/sync-android-push-credentials.js && EXPO_PUBLIC_APP_ENV=test expo run:android --variant release",
    "android:release:prod": "node scripts/sync-android-push-credentials.js && EXPO_PUBLIC_APP_ENV=production expo run:android --variant release",
    "prebuild:test": "SENTRY_USE_XCFRAMEWORK=0 EXPO_PUBLIC_APP_ENV=test expo prebuild --clean && node scripts/sync-android-push-credentials.js",
    "prebuild:prod": "SENTRY_USE_XCFRAMEWORK=0 EXPO_PUBLIC_APP_ENV=production expo prebuild --clean && node scripts/sync-android-push-credentials.js",
    "ios": "SENTRY_USE_XCFRAMEWORK=0 expo run:ios --device",
    "ios:test": "SENTRY_USE_XCFRAMEWORK=0 EXPO_PUBLIC_APP_ENV=test expo run:ios --device",
    "ios:sim:test": "SENTRY_USE_XCFRAMEWORK=0 EXPO_PUBLIC_APP_ENV=test expo run:ios",
    "ios:prod": "SENTRY_USE_XCFRAMEWORK=0 EXPO_PUBLIC_APP_ENV=production expo run:ios --device",
    "ios:release:test": "SENTRY_USE_XCFRAMEWORK=0 EXPO_PUBLIC_APP_ENV=test expo run:ios --device --configuration Release",
    "web": "expo start --web",
    "build:web": "NODE_ENV=production expo export --platform web && sh scripts/postbuild-web.sh dist",
    "build:web:test": "EXPO_PUBLIC_APP_ENV=test NODE_ENV=production expo export --platform web -c && sh scripts/postbuild-web.sh dist",
    "build:web:prod": "EXPO_PUBLIC_APP_ENV=production NODE_ENV=production expo export --platform web -c && sh scripts/postbuild-web.sh dist",
    "verify:web:gzip": "sh scripts/verify-web-gzip.sh",
    "eas:android:test": "APP_ENV=test eas build -p android --profile test",
    "eas:android:prod": "APP_ENV=production eas build -p android --profile production",
    "eas:ios:test": "APP_ENV=test eas build -p ios --profile test",
    "eas:ios:prod": "APP_ENV=production eas build -p ios --profile production",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "serve:web": "node scripts/serve-dist.js dist 4173",
    "analyze:web": "node scripts/analyze-web-chunks.js",
    "smoke:web": "node scripts/smoke-web.js http://127.0.0.1:4173 / /login /register /profile /chat /annotators /performance /performance-settlement /feature/profile/reset-password /feature/chat/custom-stickers /feature/chat/my-favorites /feature/performance/salary-details /feature/annotators/1/sessions /feature/annotators/1/assign-actors /feature/chat/actor-info/1 /chat/1",
    "verify:web:version": "node scripts/verify-build-version.js http://127.0.0.1:4173 dist"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@breezystack/lamejs": "^1.2.7",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "11.5.2",
    "@sentry/react-native": "^8.4.0",
    "antd": "^6.6.1",
    "dexie": "^4.4.5",
    "expo": "~55.0.4",
    "expo-audio": "~55.0.0",
    "expo-clipboard": "~55.0.14",
    "expo-constants": "~55.0.16",
    "expo-document-picker": "~55.0.0",
    "expo-file-system": "~55.0.23",
    "expo-font": "~55.0.8",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.18",
    "expo-image-picker": "~55.0.21",
    "expo-linking": "~55.0.15",
    "expo-media-library": "~55.0.19",
    "expo-notifications": "~55.0.23",
    "expo-router": "~55.0.16",
    "expo-sharing": "~55.0.22",
    "expo-splash-screen": "~55.0.21",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-video": "~55.0.19",
    "expo-video-thumbnails": "~55.0.0",
    "expo-web-browser": "~55.0.16",
    "jcore-react-native": "^2.3.6",
    "jpush-react-native": "^3.1.9",
    "mx-jpush-expo": "^1.2.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-swipe-list-view": "^3.2.9",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-zoom-pan-pinch": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "@types/react-native__assets-registry": "^0.84.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "expo-build-properties": "^55.0.15",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "expo-font": "~55.0.8"
    }
  },
  "volta": {
    "node": "24.14.0",
    "pnpm": "9.15.3"
  }
}
